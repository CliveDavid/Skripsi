# Copy to .env only if you do not already have one, then replace placeholders.
# These are example values, not existing database or website credentials.
PORT=3000

DATABASE_NAME=SJM
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-local-database-password
DATABASE_HOST=localhost
DATABASE_DIALECT=postgres
# config/database.js uses PostgreSQL's default port (5432).
# DATABASE_URL and DATABASE_PORT are not read by the current configuration.

ADMIN_SESSION_SECRET=replace-with-a-long-random-admin-secret
DISTRIBUTOR_SESSION_SECRET=replace-with-a-different-long-random-secret

# EmailService currently uses smtp.gmail.com:465 with TLS.
EMAIL_USER=your-sender@gmail.com
EMAIL_PASS=replace-with-your-mail-app-password
SUPPORT_EMAIL=your-support@example.com
